# Copy to .env and fill in before running: docker compose up -d --build
DB_PASSWORD=change-me
# Folder on the server that holds your songs
MUSIC_HOST_DIR=./backend/music
# Port the site is served on
WEB_PORT=80

# Single-password lock. Leave APP_PASSWORD empty to disable (local dev).
# APP_SECRET signs session cookies; generate one with: openssl rand -hex 32
APP_PASSWORD=
APP_SECRET=
